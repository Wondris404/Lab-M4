{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions actually used: pty and shell commands, window basics, directory picker, and the About links.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-request-user-attention",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "dialog:allow-open",
    "opener:allow-open-url",
    "allow-spawn-powershell",
    "allow-write-powershell",
    "allow-resize-powershell",
    "allow-kill-powershell",
    "allow-load-sessions",
    "allow-save-sessions",
    "allow-agent-hook-url",
    "allow-load-app-settings",
    "allow-save-app-settings",
    "allow-chat-send",
    "allow-chat-stop",
    "allow-chat-reset",
    "allow-usage-list-sources",
    "allow-usage-select-source",
    "allow-usage-remove-source",
    "allow-usage-scan"
  ]
}
