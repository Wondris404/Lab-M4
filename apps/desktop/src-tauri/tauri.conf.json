{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lab-M4",
  "version": "1.0.0",
  "identifier": "com.wondris.labm4",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. package:usage-sidecar && pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm --dir ../.. package:usage-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lab-M4",
        "width": 900,
        "height": 700,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../usage-service/": "usage-service/"
    }
  }
}
