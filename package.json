{
  "name": "lab-m4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --filter wraith dev",
    "tauri": "pnpm --filter wraith tauri",
    "build": "pnpm --filter wraith build",
    "typecheck": "tsc --noEmit && pnpm --filter wraith build",
    "test": "vitest run",
    "lint": "eslint packages/usage-core/src packages/usage-core/tests",
    "usage": "node scripts/usage-cli.mjs",
    "orchestrator:fake": "node packages/orchestrator-core/src/cli.mjs",
    "orchestrator:preflight": "node packages/orchestrator-core/src/agent-preflight.mjs",
    "test:orchestrator": "node --test packages/orchestrator-core/tests/lifecycle.test.mjs packages/orchestrator-core/tests/cli.test.mjs packages/orchestrator-core/tests/usage-ledger.test.mjs packages/orchestrator-core/tests/agent-rpc.test.mjs packages/orchestrator-core/tests/agent-preflight.test.mjs packages/orchestrator-core/tests/review.test.mjs",
    "package:usage-sidecar": "node scripts/package-usage-sidecar.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "fzstd": "^0.1.1",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "sqlite3": "^5.1.7",
    "xxhash-wasm": "1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.25.12",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
