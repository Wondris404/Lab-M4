{
  "name": "agent-usage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/server/index.ts\" \"vite --open\"",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "build": "tsc -p tsconfig.server.json && tsc --noEmit && vite build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "fzstd": "^0.1.1",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
